{
  "name": "faah",
  "version": "0.1.16",
  "type": "module",
  "private": true,
  "description": "High-performance code reader and review engine",
  "scripts": {
    "aislop": "aislop scan",
    "aislop:ci": "aislop ci",
    "build": "node ./scripts/build-web.js",
    "build-web": "node ./scripts/build-web.js",
    "check": "node ./scripts/check-web.js",
    "desktop": "node ./scripts/build-desktop.js --run",
    "dev:desktop": "node ./scripts/dev-desktop.js",
    "desktop:smoke": "node ./scripts/build-desktop.js --smoke",
    "desktop:package": "node ./scripts/build-desktop.js --package",
    "desktop:dist": "node ./scripts/build-desktop.js --dist",
    "test": "vitest run",
    "lint": "eslint web/src vite.config.ts eslint.config.js scripts/build-web.js scripts/check-web.js scripts/eslint-typescript/index.js",
    "format": "prettier --write web/src vite.config.ts eslint.config.js scripts/build-web.js scripts/check-web.js scripts/eslint-typescript/index.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@iconify-json/lucide": "1.2.153",
    "@iconify/tailwind4": "1.2.3",
    "@solidjs/testing-library": "0.8.10",
    "@tailwindcss/cli": "4.3.5",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "24.19.2",
    "aislop": "0.20.1",
    "basecoat-css": "1.1.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-solid": "0.19.0",
    "eslint-typescript": "file:scripts/eslint-typescript",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "prettier": "3.10.1",
    "solid-js": "1.9.19",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vite-plugin-solid": "2.11.16",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
